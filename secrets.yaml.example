# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# Generate the API encryption key with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Your lamp's BLE MAC address.
lamp_mac: "F8:24:41:XX:XX:XX"

api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"
ota_password: "your-ota-password"
ap_password: "at-least-8-chars"
